  {
    "key": "steam_ui_4f3b7699da0e9cd4f97f_2.0.6.454aad8",
    "original": "Welcome to our updated procedural generation system! You can load from any existing save game, but please note that your map will now have regenerated, and you've been moved to the New Winchester starting area.",
    "translation": ""
  },
  {
    "key": "steam_ui_7cc1052c2c14f1b77c02_2.0.6.454aad8",
    "original": "Welcome to the updated Albion region! Loading from an existing saved game will preserve your story progress, but be warned that your map of the region will be blank. As its contents have moved around, you'll need to re-explore it.",
    "translation": ""
  },
  {
    "key": "steam_ui_2d4395b20998e767294d_2.0.6.454aad8",
    "original": "Welcome to the updated Reach region! Loading from an existing saved game will preserve your story progress, but be warned that your map of the region will be blank. As its contents have moved around, you'll need to re-explore it.",
    "translation": ""
  },
  {
    "key": "steam_ui_cab4bbe43666ffc7fd94_2.0.6.454aad8",
    "original": "What does winning mean to you?",
    "translation": ""
  },
  {
    "key": "steam_ui_070d605db4633d50dd65_2.0.6.454aad8",
    "original": "With your assistance, your successor will start out stronger and wiser than you did. Perhaps one day they will even surpass you.",
    "translation": ""
  },
  {
    "key": "steam_ui_98a34580cef6710effc8_2.0.6.454aad8",
    "original": "You donate your - now slightly faded - chart.",
    "translation": ""
  },
  {
    "key": "steam_ui_5383dc9db13edddd8871_2.0.6.454aad8",
    "original": "You donate your heirloom as a reminder of all you have achieved.",
    "translation": ""
  },
  {
    "key": "steam_ui_de249c7205e1a11a5561_2.0.6.454aad8",
    "original": "You fill in some of your chart.",
    "translation": ""
  },
  {
    "key": "steam_ui_b7b1e5daaeb782a0d6b5_2.0.6.454aad8",
    "original": "You have not yet revealed any facets. Return here once you've gained enough experience to unlock one!",
    "translation": ""
  },
  {
    "key": "steam_ui_09ec15936043ceeb6c27_2.0.6.454aad8",
    "original": "You inherit a copy of your predecessor's chart, though it lacks the details of their final voyage.",
    "translation": ""
  },
  {
    "key": "steam_ui_02b7f24ae8ffdaccc034_2.0.6.454aad8",
    "original": "You no longer meet the requirements to use all your locomotive equipment. This will halve your maximum heat: to fix it, change your equipment in port or raise your abilities to meet all the requirements.",
    "translation": ""
  },
  {
    "key": "steam_ui_74a0f464e28a27a6c3fd_2.0.6.454aad8",
    "original": "You receive the heirlooms of your predecessor.",
    "translation": ""
  },
  {
    "key": "steam_ui_54890455b1347a6449e0_2.0.6.454aad8",
    "original": "You will begin your career with the benefit of some of your predecessor's experience.",
    "translation": ""
  },
  {
    "key": "steam_ui_e40036c70356a44e88ad_2.0.6.454aad8",
    "original": "Your legacy",
