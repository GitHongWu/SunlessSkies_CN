  {
    "key": "ui_runtime_7ecafd6ab8fa",
    "original": "Your predecessor's academic affiliations resulted in a generous donation from an admirer of their intellectual rigour.",
    "translation": ""
  },
  {
    "key": "ui_runtime_bfb634140f15",
    "original": "Your fellow academics will ensure the next captain in your lineage receives the benefit of some of the discoveries you made.",
    "translation": ""
  },
  {
    "key": "ui_runtime_ebdec011c8e1",
    "original": "Convention did not dictate your predecessor's life. Their fellow Bohemians collaborated to provide this gift, in their memory.",
    "translation": ""
  },
  {
    "key": "ui_runtime_426b792d17d7",
    "original": "Your Bohemian friends are eager to meet your successor. They have gifts!",
    "translation": ""
  },
  {
    "key": "ui_runtime_f2508745d121",
    "original": "Your predecessor worked for the empire. To honour their establishment affiliations, you have been given a generous gift.",
    "translation": ""
  },
  {
    "key": "ui_runtime_b64168348afb",
    "original": "Your establishment associates will not forget you. They promise to keep an eye on your inheritor, and pass along some of the favours you earned.",
    "translation": ""
  },
  {
    "key": "ui_runtime_a71e09a02ff9",
    "original": "An honest gift, or stolen goods? Your predecessor's villainous affiliations have profited you well.",
    "translation": ""
  },
  {
    "key": "ui_runtime_85a64bcf9da8",
    "original": "You moved in villainous circles. They remember their debts. Your successor will benefit from their unspoken code of honour.",
    "translation": ""
  }
]
